
# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The secure key Craft will use for hashing and encrypting data
CRAFT_SECURITY_KEY=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=dev

#Language & Project Settings
PROJECT_NAME="Boilerplate"
PRIMARY_LANGUAGE="nl-BE"
ACTIVATE_EN="true"
ACTIVATE_FR="true"
ACTIVATE_DE="false"

# Database connection settings
CRAFT_DB_DRIVER="mysql"
CRAFT_DB_SERVER="db"
CRAFT_DB_PORT="3306"
CRAFT_DB_DATABASE="db"
CRAFT_DB_USER="db"
CRAFT_DB_PASSWORD="db"
CRAFT_DB_SCHEMA=
CRAFT_DB_TABLE_PREFIX=

# General settings (see config/general.php)
DEV_MODE=true
ALLOW_ADMIN_CHANGES=true
DISALLOW_ROBOTS=true
CRAFT_WEB_ROOT="/var/www/html/web"
PRIMARY_SITE_URL="https://testing.digitalejungle.be/"

#Plugins
FREE_NAV_ON=true
FORMIE_ON=true
FORMIE_KEY=""
GALLERY_KEY=""
CLOUDINARY_ON=true
QR_CODE_ON=true

#Colors
COLOR1='#4984ff'
COLOR2='#1c3e86'
COLOR_WHITE='#effffe'
COLOR_LIGHT='#aecffc'
COLOR_DARK='#323232'
COLOR_BLACK='#000000'
TRANS='40' #0%=ff 25%=bf 50%=80 75%=40 100%=00

#Recaptcha
RECAPTCHA_PUBLIC=""
RECAPTCHA_SECRET=""
TURNSTILE_SITE=""
TURNSTILE_SECRET=""

#Cloudinary
CLOUD_NAME=""
CLOUD_API=""
CLOUD_SECRET=""

# Mail settings
SMTP_HOSTNAME=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_FROM=""
SMTP_PASS=""
SMTP_REPLY_TO=""
SMTP_SENDER_NAME=""

MAILPIT_SMTP_PORT="1025"
MAILPIT_SMTP_HOSTNAME="127.0.0.1"

BREVO_API=""